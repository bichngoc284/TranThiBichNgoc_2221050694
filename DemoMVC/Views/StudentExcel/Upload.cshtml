<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-file-earmark-excel"></i> Import Sinh Viên từ Excel
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-check-circle"></i> Thành công!</strong> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i> Lỗi!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-upload"></i> Tải lên File Excel</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <form asp-action="Upload" asp-controller="StudentExcel" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="file" class="form-label">Chọn File Excel:</label>
                            <input type="file" name="file" id="file" class="form-control" 
                                   accept=".xlsx,.xls" required />
                            <div class="form-text">
                                Chấp nhận file .xlsx hoặc .xls
                            </div>
                        </div>

                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-upload"></i> Upload và Import
                            </button>
                            <a asp-action="Index" asp-controller="Student" class="btn btn-secondary ms-2">
                                <i class="bi bi-arrow-left"></i> Quay lại
                            </a>
                        </div>
                    </form>
                </div>

                <div class="col-md-4">
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title"><i class="bi bi-info-circle"></i> Hướng dẫn</h6>
                            <ol class="mb-0">
                                <li>Tải file mẫu Excel</li>
                                <li>Nhập dữ liệu sinh viên</li>
                                <li>Upload file đã điền</li>
                                <li>Dữ liệu sẽ được lưu vào CSDL</li>
                            </ol>
                            <hr />
                            <a asp-action="DownloadTemplate" class="btn btn-success btn-sm w-100">
                                <i class="bi bi-download"></i> Tải File Mẫu
                            </a>
                            <a asp-action="ListFaculties" class="btn btn-info btn-sm w-100 mt-2">
                                <i class="bi bi-building"></i> Xem Mã Khoa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-table"></i> Cấu trúc File Excel</h5>
        </div>
        <div class="card-body">
            <p>File Excel cần có các cột sau (theo thứ tự):</p>
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Cột A</th>
                        <th>Cột B</th>
                        <th>Cột C</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Mã Sinh Viên</strong></td>
                        <td><strong>Họ và Tên</strong></td>
                        <td><strong>Mã Khoa</strong></td>
                    </tr>
                    <tr class="text-muted">
                        <td>SV001</td>
                        <td>Nguyễn Văn A</td>
                        <td>K01</td>
                    </tr>
                </tbody>
            </table>
            <div class="alert alert-info mb-0">
                <i class="bi bi-lightbulb"></i> <strong>Lưu ý:</strong> Dòng đầu tiên là tiêu đề, dữ liệu bắt đầu từ dòng 2.
            </div>
        </div>
    </div>
</div>
