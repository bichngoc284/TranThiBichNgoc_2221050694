@model IEnumerable<DemoMVC.Models.Faculty>

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-building"></i> Danh sách Mã Khoa
    </h2>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-list-ul"></i> Thông tin các Khoa</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i> 
                Sử dụng <strong>Mã Khoa</strong> (Id) khi nhập dữ liệu trong file Excel import sinh viên.
            </p>
            
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Khoa</th>
                        <th>Tên Khoa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var faculty in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@faculty.Id</strong></td>
                            <td>@faculty.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Upload" class="btn btn-primary">
            <i class="bi bi-upload"></i> Quay lại Import
        </a>
    </div>
</div>
