@model DemoMVC.Models.OrderDetail

@{
    ViewData["Title"] = "Xóa chi tiết đơn hàng";
}

<h1>Xóa chi tiết đơn hàng</h1>

<h3>Bạn có chắc chắn muốn xóa chi tiết đơn hàng này?</h3>
<div>
    <h4>Chi tiết đơn hàng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            Đơn hàng
        </dt>
        <dd class = "col-sm-10">
            @(Model.Order?.Id) - @(Model.Order?.Customer?.Name ?? "N/A")
        </dd>
        <dt class = "col-sm-2">
            Sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @(Model.Product?.Name ?? "N/A")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            Thành tiền
        </dt>
        <dd class = "col-sm-10">
            @((Model.Quantity * Model.Price).ToString("N0")) VND
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </form>
</div>