@model IEnumerable<DemoMVC.Models.OrderDetail>

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

<h1>Chi Tiết Đơn Hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo Mới</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                Đơn Hàng
            </th>
            <th>
                Sản Phẩm
            </th>
            <th>
                Số Lượng
            </th>
            <th>
                Giá
            </th>
            <th>
                Thành Tiền
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @(item.Order?.Id) - @(item.Order?.Customer?.Name ?? "N/A")
            </td>
            <td>
                @(item.Product?.Name ?? "N/A")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @((item.Quantity * item.Price).ToString("N0")) VND
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Chi Tiết</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>