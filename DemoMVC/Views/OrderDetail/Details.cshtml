@model DemoMVC.Models.OrderDetail

@{
    ViewData["Title"] = "Chi tiết chi tiết đơn hàng";
}

<h1>Chi tiết chi tiết đơn hàng</h1>

<div>
    <h4>Chi tiết đơn hàng</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            Đơn hàng
        </dt>
        <dd class = "col-sm-10">
            @(Model.Order?.Id) - @(Model.Order?.Customer?.Name ?? "N/A")
        </dd>
        <dt class = "col-sm-2">
            Sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @(Model.Product?.Name ?? "N/A")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            Thành tiền
        </dt>
        <dd class = "col-sm-10">
            @((Model.Quantity * Model.Price).ToString("N0")) VND
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a> |
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>