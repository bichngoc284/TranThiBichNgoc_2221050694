@model DemoMVC.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h1>Chi tiết đơn hàng #@Model.Id</h1>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Khách hàng:</strong> @(Model.Customer?.Name ?? "N/A")</p>
    </div>
</div>

@if (Model.OrderDetails != null && Model.OrderDetails.Any())
{
    <h3>Thông tin sản phẩm</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Tên sản phẩm</th>
                <th style="width: 15%; text-align: center;">Số lượng</th>
                <th style="width: 20%; text-align: right;">Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.OrderDetails)
            {
                <tr>
                    <td>@(detail.Product?.Name ?? "N/A")</td>
                    <td style="text-align: center;">@detail.Quantity</td>
                    <td style="text-align: right;">
                        <strong>@((detail.Quantity * detail.Price).ToString("N0")) VND</strong>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2" style="text-align: right;">Tổng tiền:</th>
                <th style="text-align: right;">
                    <strong class="text-success">@(Model.OrderDetails.Sum(d => d.Quantity * d.Price).ToString("N0")) VND</strong>
                </th>
            </tr>
        </tfoot>
    </table>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
</div>