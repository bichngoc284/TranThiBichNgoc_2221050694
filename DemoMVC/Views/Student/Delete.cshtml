@model DemoMVC.Models.ViewModels.StudentVM

@{
    ViewData["Title"] = "Xóa Sinh viên";
}

<h1>@ViewData["Title"]</h1>

<h3>Bạn có chắc chắn muốn xóa?</h3>
<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Mã Sinh viên
        </dt>
        <dd class = "col-sm-10">
            @Model.StudentCode
        </dd>
        <dt class = "col-sm-2">
            Họ và Tên
        </dt>
        <dd class = "col-sm-10">
            @Model.FullName
        </dd>
        <dt class = "col-sm-2">
            Khoa
        </dt>
        <dd class = "col-sm-10">
            @Model.FacultyName
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>