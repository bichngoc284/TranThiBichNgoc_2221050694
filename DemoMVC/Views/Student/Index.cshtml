@model IEnumerable<DemoMVC.Models.ViewModels.StudentVM>

@{
    ViewData["Title"] = "Danh sách Sinh viên";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary me-2">Thêm Sinh viên mới</a>
    <a asp-controller="Faculty" asp-action="Index" class="btn btn-secondary">Quản lý Khoa</a>
</p>

<form asp-action="Index" method="get" class="form-inline mb-3">
    <div class="form-group me-2">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên..." />
    </div>
    <div class="form-group me-2">
        <select name="facultyId" class="form-control">
            <option value="">-- Chọn Khoa --</option>
            @foreach (var item in (SelectList)ViewBag.FacultyId)
            {
                if (item.Value == (ViewBag.SelectedFacultyId?.ToString() ?? ""))
                {
                    <option value="@item.Value" selected>@item.Text</option>
                }
                else
                {
                    <option value="@item.Value">@item.Text</option>
                }
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Tìm</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Xóa</a>
</form>
<form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
    <input type="file" name="file" />
    <button type="submit">Import Excel</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Họ và Tên</th>
            <th>Mã Sinh viên</th>
            <th>Khoa</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @item.Id
            </td>
            <td>
                @item.FullName
            </td>
            <td>
                @item.StudentCode
            </td>
            <td>
                @item.FacultyName
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
                @Html.ActionLink("Details", "Details", new { id=item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id=item.Id })
            </td>
        </tr>
}
    </tbody>
</table>
