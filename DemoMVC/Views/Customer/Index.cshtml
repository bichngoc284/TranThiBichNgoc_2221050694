@model IEnumerable<DemoMVC.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<h1>Quản lý Khách hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm khách hàng mới</a>
</p>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Tên khách hàng</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Xem</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>