@model DemoMVC.Models.Customer

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Lịch sử đơn hàng</h2>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                ← Quay lại thông tin khách hàng
            </a>
        </div>
    </div>

    <!-- Thông tin khách hàng-->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Thông tin khách hàng</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Tên:</strong> @Model.Name</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Số điện thoại:</strong> @Model.Phone</p>
                    <p><strong>Tổng số đơn hàng:</strong> <span class="badge bg-success">@Model.Orders.Count</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách đơn hàng -->
    @if (Model.Orders != null && Model.Orders.Any())
    {
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Danh sách đơn hàng (@Model.Orders.Count)</h5>
            </div>
            <div class="card-body">
                @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                {
                    <div class="card mb-3 border-left border-primary">
                        <div class="card-header" style="background-color: #f8f9fa;">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h6 class="mb-0">
                                        Đơn hàng <strong>#@order.Id</strong> - 
                                        <span class="text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                    </h6>
                                </div>
                                <div class="col-md-4 text-end">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" 
                                       class="btn btn-sm btn-outline-primary">Xem chi tiết →</a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr style="background-color: #f8f9fa;">
                                            <th style="width: 40%;">Sản phẩm</th>
                                            <th style="width: 15%;">Số lượng</th>
                                            <th style="width: 20%;">Đơn giá</th>
                                            <th style="width: 25%; text-align: right;">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@detail.Product?.Name</strong>
                                                    @if (!string.IsNullOrEmpty(detail.ProductCode))
                                                    {
                                                        <br />
                                                        <small class="text-muted">Mã: @detail.ProductCode</small>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark">@detail.Quantity</span>
                                                </td>
                                                <td>@detail.Price.ToString("N0") VND</td>
                                                <td style="text-align: right;">
                                                    <strong>@((detail.Quantity * detail.Price).ToString("N0")) VND</strong>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot style="border-top: 2px solid #dee2e6;">
                                        <tr>
                                            <td colspan="2"><strong>Tổng cộng:</strong></td>
                                            <td colspan="2" style="text-align: right;">
                                                <h6 class="mb-0">
                                                    <strong style="color: #0d6efd;">@order.TotalAmount.ToString("N0") VND</strong>
                                                </h6>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                            else
                            {
                                <p class="text-muted mb-0">Đơn hàng này không có sản phẩm</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h5>Chưa có đơn hàng</h5>
            <p class="mb-0">Khách hàng này chưa có bất kì đơn hàng nào.</p>
        </div>
    }
</div>

<style>
    .border-left {
        border-left: 4px solid !important;
    }
    
    .border-primary {
        border-color: #0d6efd !important;
    }
    
    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }
</style>
